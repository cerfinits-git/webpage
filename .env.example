# Copy to .env.local and fill in. .env*.local is gitignored.
#
# Nothing here is required to run the marketing site, /grade, /research or
# /quiz — those work on an empty file. The keys below unlock the parts that
# talk to something: sign-in, the portfolio, and the journal.

# ── Supabase ───────────────────────────────────────────────────────────
# Database and auth. The project currently lives in Seoul (ap-northeast-2),
# which the privacy notice discloses as a cross-border transfer — changing
# region means editing lib/legal.ts too, and a test enforces that.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Prefer the 2026 publishable key. Never put a secret key in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Compatibility only for older projects; the publishable key wins when both exist.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses row-level security — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google sign-in ─────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (web). The redirect URI must match exactly, including the port.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── cTrader ────────────────────────────────────────────────────────────
# Only needed to import real trades into the Journal. Register at
# openapi.ctrader.com. Tokens are encrypted at rest with CTRADER_TOKEN_KEY, so
# losing that key means every stored connection has to be linked again.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=http://localhost:3000/api/ctrader/callback
# 32 bytes, base64. Generate with: openssl rand -base64 32
CTRADER_TOKEN_KEY=

# ── Feature gates ──────────────────────────────────────────────────────
# Both halves fail closed in production on purpose. Journal needs auth and RLS
# tests before it opens; Plan still keeps a global JSON store rather than
# per-user rows. Set these true locally to work on them.
JOURNAL_ENABLED=false
JOURNAL_SUPABASE_AUTH_ENABLED=false
PLAN_ENABLED=false

# Journal remote persistence, separate from the gate above. Stays off until
# Supabase auth, RLS tests, and staging checksum reconciliation pass.
JOURNAL_SYNC_ENABLED=false
JOURNAL_SYNC_DRY_RUN=true

# ── Optional ───────────────────────────────────────────────────────────
# Canonical URL for sitemap, robots and OG tags. Defaults to production.
NEXT_PUBLIC_SITE_URL=

# Thai fund NAV lookups. Free key at api-portal.sec.or.th. Without it, NAV is
# entered by hand through the ✎ button on /plan/portfolio.
SEC_API_KEY=

# AI Stock Advisor on /plan/portfolio. Roughly ฿2-7 per run. Without it the
# card explains how to set it up instead of calling out.
ANTHROPIC_API_KEY=
